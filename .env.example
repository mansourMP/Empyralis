# Runtime API authentication
# ORION_JWT_SECRET must be a random 32+ character string in production.
ORION_JWT_SECRET=replace-with-a-random-32-plus-character-secret
ORION_API_KEY=replace-with-a-random-runtime-api-key
ORION_ENV=production
ORION_LOG_FORMAT=json
EMPYRALIS_STATE_HOME=/var/data/empyralis/state
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empyralis

# Broker secrets (REQUIRED - server refuses to start without these)
EMPYRALIS_TOOL_BROKER_SECRET=
EMPYRALIS_SECRETS_BROKER_SECRET=

# Credential vault encryption key (REQUIRED for provider API keys to work)
CREDENTIAL_VAULT_KEY=

# CORS origins (REQUIRED in production)
CONTROL_PLANE_ORIGINS=https://yourdomain.com
FRONTEND_ORIGINS=https://yourdomain.com

# Public URL of this Empyralis deployment
# Used as fallback for upgrade CTAs
EMPYRALIS_PUBLIC_URL=https://app.empyralis.com

ORION_WHATSAPP_AUTOPILOT_PUBLIC_BASE_URL=https://empyralis-runtime.example.com
SENTRY_DSN=           # Get from sentry.io -> new project -> Python
NEXT_PUBLIC_SENTRY_DSN=  # Same DSN works for both
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
AGENT_MACHINE_MODE=personal   # set to "agent" for a dedicated agent machine
AGENT_MACHINE_OWNER=          # authenticated runtime user_id that owns the machine

# ── Billing: Polar (Merchant of Record) ─────────────────────────────────
# Empyralis is billed through Polar, not Stripe — Stripe has no standalone
# merchant account in Uzbekistan. See CLAUDE.md, "Payment processor is
# Polar, not Stripe" (2026-08-20). Leaving these unset is a supported,
# working state: checkout/portal routes return HTTP 503 and the frontend
# shows "not configured yet" rather than erroring. Founder setup steps for
# each var are listed below; polar_client.py documents the exact request/
# response shapes these are used for.

# Organization Access Token, minted in the Polar dashboard under
# Settings -> Developers -> Access Tokens (needs checkouts:write and
# customer_sessions:write at minimum).
EMPYRALIS_POLAR_ACCESS_TOKEN=

# "production" or "sandbox". Defaults to "sandbox" if unset — a deliberate
# safe default, since an access token only works against the environment
# it was minted for, so a wrong guess here 401s instead of risking a real
# charge. Set to "production" only once ready to take real payments.
EMPYRALIS_POLAR_SERVER=sandbox

# From the webhook endpoint you create in the Polar dashboard
# (Settings -> Webhooks -> Add Endpoint, pointed at
# https://<your-domain>/api/billing/webhooks/polar). Polar shows the
# signing secret once, at creation time.
EMPYRALIS_POLAR_WEBHOOK_SECRET=

# The Polar PRODUCT id for the "Pro" plan (a recurring/subscription
# product you create in the Polar dashboard). JSON map form, or set
# EMPYRALIS_POLAR_PRODUCT_PRO directly for just the one plan that exists
# today — either is read, the per-plan var wins on conflict.
EMPYRALIS_POLAR_PRODUCT_IDS={"pro":""}
EMPYRALIS_POLAR_PRODUCT_PRO=

# The Polar product used for hosted-AI credit top-ups (an arbitrary $
# amount, not a fixed plan price). This MUST be created in the Polar
# dashboard with price type "Pay what you want" (Polar's checkout API has
# no equivalent of Stripe's inline ad-hoc pricing — see polar_client.py's
# create_checkout_session docstring) with a min/max that covers $1-$500
# (billing_service._MIN_CREDIT_PURCHASE_USD / _MAX_CREDIT_PURCHASE_USD).
EMPYRALIS_POLAR_CREDIT_PRODUCT_ID=

# Optional overrides for where a checkout/portal session redirects —
# provider-agnostic, already used by the (now-removed) Stripe integration
# too. Fall back to EMPYRALIS_PUBLIC_URL / FRONTEND_ORIGINS above + a
# sensible path when unset.
# EMPYRALIS_BILLING_SUCCESS_URL=
# EMPYRALIS_BILLING_CANCEL_URL=
# EMPYRALIS_BILLING_CREDIT_SUCCESS_URL=
# EMPYRALIS_BILLING_CREDIT_CANCEL_URL=
# EMPYRALIS_BILLING_PORTAL_RETURN_URL=
