# Backend API URL
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ORION_API_URL=
NEXT_PUBLIC_WS_URL=

# Web Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMPYRALIS_AUTH_ALLOWED_ORIGINS=

# Google Workspace connector OAuth (Gmail, Calendar, Drive).
# Redirect URI: https://empyralis.ai/api/connections/oauth/google_workspace/callback
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=

# Which Google scopes this deployment's connected OAuth app currently
# declares on its consent screen -- see connection_oauth_service.
# google_workspace_enabled_capabilities(). Space/comma-separated capability
# keys: drive, gmail, calendar. Left unset here on purpose: unset already
# defaults to "drive" (identity + Drive only), matching the unverified-
# clean consent screen as of 2026-08-12 -- gmail.modify and calendar are
# Google-classified sensitive/restricted scopes withheld until a separate,
# verified OAuth app exists for them. Requesting a scope this deployment's
# consent screen doesn't declare fails the OAuth start with a coded error
# rather than Google's own raw "invalid_scope" page, so only set this to
# include gmail/calendar once they are actually declared at Google.
GOOGLE_WORKSPACE_OAUTH_ENABLED_SCOPES=
