{
  "productName": "Empyralis",
  "version": "0.1.0",
  "identifier": "com.empyralis.desktop",
  "mainBinaryName": "empyralis-tauri-shell",
  "build": {
    "frontendDist": "dist-stub",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png"
    ],
    "resources": {
      "../empyralis-gateway/dist": "gateway/dist",
      "resources/node-runtime": "node-runtime",
      "resources/gateway-node-modules": "gateway/node_modules"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
