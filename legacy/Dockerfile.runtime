FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8001 \
    ORION_RUNTIME_HOST=0.0.0.0 \
    EMPYRALIS_STATE_HOME=/var/data/empyralis/state

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-worker.txt ./
RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install -r requirements.txt

COPY . .

RUN mkdir -p /var/data/empyralis/state

EXPOSE 8001

CMD ["sh", "-c", "python -m uvicorn server:app --host ${ORION_RUNTIME_HOST:-0.0.0.0} --port ${PORT:-8001}"]
