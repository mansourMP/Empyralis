{
  "name": "empyralis-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent local gateway for Empyralis personal channels and local runtime control-plane connectivity.",
  "main": "dist/index.js",
  "scripts": {
    "build": "./node_modules/.bin/tsc -p tsconfig.json",
    "typecheck": "./node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/__tests__/*.test.js",
    "dev:bridge": "npm run build --silent && node dist/dev/local-bridge-harness.js",
    "signal:bridge": "npm run build --silent && node dist/bridges/signal-cli-bridge.js",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.1.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "pino": "^10.3.1",
    "telegram": "^2.0.0"
  }
}
