# Backend API URL
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ORION_API_URL=
NEXT_PUBLIC_WS_URL=

# Web Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMPYRALIS_AUTH_ALLOWED_ORIGINS=

# Google Workspace connector OAuth for Gmail and Calendar.
# Redirect URI: https://empyralis.ai/api/connections/oauth/google_workspace/callback
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=

# Keep Drive out of the default Google verification pass unless Drive is also
# demo-ready and listed in the Google OAuth consent verification video.
GOOGLE_WORKSPACE_ENABLE_DRIVE_SCOPE=false
