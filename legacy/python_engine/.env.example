# Agency OS - LLM Configuration
# Copy this file to .env and configure your API keys

# Model Selection
# Cheap model for fast tasks (research, drafting)
CHEAP_MODEL=gemini/gemini-1.5-flash
# CHEAP_MODEL=openai/gpt-4o-mini
# CHEAP_MODEL=anthropic/claude-3-haiku-20240307

# Smart model for complex reasoning (critic, decisions)
SMART_MODEL=anthropic/claude-3-5-sonnet-20241022
# SMART_MODEL=openai/gpt-4o
# SMART_MODEL=gemini/gemini-1.5-pro

# API Keys (uncomment and set as needed)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Database
DB_PATH=agency_memory.db
