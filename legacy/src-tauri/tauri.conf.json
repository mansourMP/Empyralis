{
  "productName": "Empyralis",
  "version": "0.1.0",
  "identifier": "com.empyralis.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/.next",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png"
    ],
    "externalBin": [
      "../dist/empyralis-backend"
    ],
    "resources": []
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
