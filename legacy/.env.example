# Runtime API authentication
# ORION_JWT_SECRET must be a random 32+ character string in production.
ORION_JWT_SECRET=replace-with-a-random-32-plus-character-secret
ORION_API_KEY=replace-with-a-random-runtime-api-key
ORION_ENV=production
ORION_LOG_FORMAT=json
EMPYRALIS_STATE_HOME=/var/data/empyralis/state
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/empyralis

# Broker secrets (REQUIRED - server refuses to start without these)
EMPYRALIS_TOOL_BROKER_SECRET=
EMPYRALIS_SECRETS_BROKER_SECRET=

# Credential vault encryption key (REQUIRED for provider API keys to work)
CREDENTIAL_VAULT_KEY=

# CORS origins (REQUIRED in production)
CONTROL_PLANE_ORIGINS=https://yourdomain.com
FRONTEND_ORIGINS=https://yourdomain.com

# Public URL of this Empyralis deployment
# Used as fallback for upgrade CTAs
EMPYRALIS_PUBLIC_URL=https://app.empyralis.com

ORION_WHATSAPP_AUTOPILOT_PUBLIC_BASE_URL=https://empyralis-runtime.example.com
SENTRY_DSN=           # Get from sentry.io -> new project -> Python
NEXT_PUBLIC_SENTRY_DSN=  # Same DSN works for both
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
AGENT_MACHINE_MODE=personal   # set to "agent" for a dedicated agent machine
AGENT_MACHINE_OWNER=          # authenticated runtime user_id that owns the machine
