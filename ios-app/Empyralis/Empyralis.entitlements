<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs. `development` is correct for debug and TestFlight-internal
	     builds; Xcode's distribution flow re-signs an App Store build to
	     `production`. A device token minted under one environment is
	     rejected by the other, which is why PushManager reports its own
	     environment to the server alongside the token. -->
	<key>aps-environment</key>
	<string>development</string>

	<!-- Universal links: makes a task/document URL an agent posts into
	     Telegram or Slack open THIS APP instead of Safari. Requires an
	     apple-app-site-association file served from
	     https://empyralis.ai/.well-known/apple-app-site-association
	     carrying the real Team ID. Until that file is live these links
	     open in Safari, which is a correct degradation, not a break. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:empyralis.ai</string>
	</array>
</dict>
</plist>
