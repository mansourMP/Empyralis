#!/usr/bin/env bash
# empyralis-configure — write /etc/empyralis/agent-computer.env and start the
# gateway. This is the ONLY thing a droplet booted from the Empyralis Agent
# Computer image has left to do.
#
# STATUS: shipped on the image but not yet called by anything. Wiring
# server_modules/vps_provisioning_service.py's cloud-init to invoke it is the
# next step (MAN-128), deliberately out of scope for the image build.
#
# It exists so that step does not have to reimplement write_env_file() inside a
# heredoc inside a YAML block scalar inside a Python string — the exact
# construction that produced the bash/dash regression. Once this is on the
# image, cloud-init's entire job is one line:
#
#   empyralis-configure --pairing-token "$TOKEN" --api-url "$API_URL"
#
# Ported from write_env_file() and start_services() in
# scripts/install-agent-computer.sh (lines 259-314, 527-583).
set -Eeuo pipefail

SERVICE_USER="empyralis"
INSTALL_ROOT="/opt/empyralis/agent-computer"
STATE_ROOT="/var/lib/empyralis/agent-computer"
CONFIG_DIR="/etc/empyralis"
ENV_FILE="${CONFIG_DIR}/agent-computer.env"
CURRENT_DIR="${INSTALL_ROOT}/current"
GATEWAY_SERVICE="empyralis-gateway.service"

DEFAULT_API_URL="https://empyralis.ai/api"

PAIRING_TOKEN="${EMPYRALIS_PAIRING_TOKEN:-${EMPYRALIS_GATEWAY_PAIRING_TOKEN:-}}"
API_URL="${EMPYRALIS_API_URL:-${EMPYRALIS_GATEWAY_API_URL:-${DEFAULT_API_URL}}}"
DISPLAY_NAME="${EMPYRALIS_GATEWAY_DISPLAY_NAME:-}"
PERSONAL_CHANNELS_ENABLED="${EMPYRALIS_GATEWAY_PERSONAL_CHANNELS_ENABLED:-true}"
START_SERVICE=1

usage() {
  cat >&2 <<'USAGE'
Usage: empyralis-configure --pairing-token TOKEN [options]

  --pairing-token TOKEN   Pairing token issued by the Empyralis control plane. Required.
  --api-url URL           Control-plane API base URL. Default: https://empyralis.ai/api
  --display-name NAME     Friendly name for this box. Default: the machine's hostname.
  --personal-channels BOOL  Enable full-account Telegram/WhatsApp channels. Default: true.
  --no-start              Write the env file but do not start the gateway.

Every option also reads its EMPYRALIS_* environment variable equivalent.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pairing-token) PAIRING_TOKEN="${2:-}"; shift 2 ;;
    --api-url) API_URL="${2:-}"; shift 2 ;;
    --display-name) DISPLAY_NAME="${2:-}"; shift 2 ;;
    --personal-channels) PERSONAL_CHANNELS_ENABLED="${2:-}"; shift 2 ;;
    --no-start) START_SERVICE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "empyralis-configure: unknown argument '$1'" >&2; usage; exit 2 ;;
  esac
done

if [[ "$(id -u)" != "0" ]]; then
  echo "empyralis-configure: must run as root" >&2
  exit 1
fi

if [[ -z "${PAIRING_TOKEN}" ]]; then
  echo "empyralis-configure: --pairing-token (or EMPYRALIS_PAIRING_TOKEN) is required" >&2
  exit 1
fi

if [[ -z "${API_URL}" ]]; then
  echo "empyralis-configure: --api-url resolved to empty" >&2
  exit 1
fi

if [[ -z "${DISPLAY_NAME}" ]]; then
  DISPLAY_NAME="$(hostname -f 2>/dev/null || hostname)"
fi

existing_env_value() {
  local key="$1"
  if [[ ! -r "${ENV_FILE}" ]]; then
    return 1
  fi
  awk -F= -v key="${key}" '
    $1 == key {
      value = substr($0, length(key) + 2)
      gsub(/^"/, "", value)
      gsub(/"$/, "", value)
      print value
      exit 0
    }
  ' "${ENV_FILE}"
}

shell_quote_env() {
  local value="$1"
  printf '"%s"' "${value//\"/\\\"}"
}

# Re-running must not orphan an already-paired gateway: carry forward the
# identity the gateway earned on its first registration.
existing_gateway_token="$(existing_env_value EMPYRALIS_GATEWAY_TOKEN || true)"
existing_gateway_id="$(existing_env_value EMPYRALIS_GATEWAY_ID || true)"
existing_device_id="$(existing_env_value EMPYRALIS_GATEWAY_DEVICE_ID || true)"

previous_umask="$(umask)"
umask 0077
{
  printf 'EMPYRALIS_PAIRING_TOKEN=%s\n' "$(shell_quote_env "${PAIRING_TOKEN}")"
  printf 'EMPYRALIS_GATEWAY_PAIRING_TOKEN=%s\n' "$(shell_quote_env "${PAIRING_TOKEN}")"
  printf 'EMPYRALIS_API_URL=%s\n' "$(shell_quote_env "${API_URL}")"
  printf 'EMPYRALIS_GATEWAY_API_URL=%s\n' "$(shell_quote_env "${API_URL}")"
  printf 'NODE_ENV="production"\n'
  printf 'EMPYRALIS_DEPLOY_ENV="agent-computer"\n'
  printf 'EMPYRALIS_GATEWAY_STATE_DIR=%s\n' "$(shell_quote_env "${STATE_ROOT}/gateway")"
  printf 'EMPYRALIS_STATE_HOME=%s\n' "$(shell_quote_env "${STATE_ROOT}/.empyralis/state")"
  printf 'EMPYRALIS_GATEWAY_DISPLAY_NAME=%s\n' "$(shell_quote_env "${DISPLAY_NAME}")"
  printf 'EMPYRALIS_GATEWAY_BROWSER_PROJECT_ROOT=%s\n' "$(shell_quote_env "${CURRENT_DIR}")"
  printf 'EMPYRALIS_GATEWAY_BROWSER_PYTHON="python3"\n'
  printf 'EMPYRALIS_AGENT_COMPUTER_INSTALL_DIR=%s\n' "$(shell_quote_env "${CURRENT_DIR}")"
  printf 'EMPYRALIS_GATEWAY_PERSONAL_CHANNELS_ENABLED=%s\n' "$(shell_quote_env "${PERSONAL_CHANNELS_ENABLED}")"
  printf 'EMPYRALIS_GATEWAY_CLI_SETUP_ENABLED="true"\n'
  printf 'NPM_CONFIG_PREFIX=%s\n' "$(shell_quote_env "${INSTALL_ROOT}/cli")"
  printf 'HOME=%s\n' "$(shell_quote_env "${INSTALL_ROOT}/cli/home")"
  printf 'NPM_CONFIG_CACHE=%s\n' "$(shell_quote_env "${INSTALL_ROOT}/cli/npm-cache")"
  printf 'PATH=%s\n' "$(shell_quote_env "${INSTALL_ROOT}/cli/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")"
  if [[ -n "${existing_gateway_token}" ]]; then
    printf 'EMPYRALIS_GATEWAY_TOKEN=%s\n' "$(shell_quote_env "${existing_gateway_token}")"
  fi
  if [[ -n "${existing_gateway_id}" ]]; then
    printf 'EMPYRALIS_GATEWAY_ID=%s\n' "$(shell_quote_env "${existing_gateway_id}")"
  fi
  if [[ -n "${existing_device_id}" ]]; then
    printf 'EMPYRALIS_GATEWAY_DEVICE_ID=%s\n' "$(shell_quote_env "${existing_device_id}")"
  fi
} > "${ENV_FILE}"
umask "${previous_umask}"

chown root:"${SERVICE_USER}" "${ENV_FILE}"
chmod 0640 "${ENV_FILE}"

# The install-time chown is baked into the image, but state and logs are
# re-asserted here in case anything on the box changed them.
chown -R "${SERVICE_USER}:${SERVICE_USER}" "${STATE_ROOT}" /var/log/empyralis

echo "empyralis-configure: wrote ${ENV_FILE}"

if [[ "${START_SERVICE}" != "1" ]]; then
  echo "empyralis-configure: --no-start given; not starting ${GATEWAY_SERVICE}"
  exit 0
fi

if ! command -v systemctl >/dev/null 2>&1 || [[ ! -d /run/systemd/system ]]; then
  echo "empyralis-configure: systemd is not active on this host; refusing to run the gateway unconfined" >&2
  exit 1
fi

# ── Channels, the per-box half ───────────────────────────────────────────────
#
# The transport SOFTWARE is already on this image (deploy/packer/scripts/
# 70-channel-transport.sh). What is deliberately not on it — because every
# droplet in the fleet boots from this one image — is anything per-box: the two
# loopback secrets, OpenClaw's generated config, and the systemd unit that
# carries one of those secrets. Those are minted here, on this machine, once.
#
# Runs BEFORE the gateway service starts, so the transport is already up the
# first time the gateway looks for it, and the unit's first start finds a
# config (OpenClaw refuses to start without one).
#
# NON-FATAL, exactly like install_channel_transport() in
# scripts/install-agent-computer.sh, which this is the port of: a box that
# cannot finish this still comes up as a fully working Agent Computer. Channels
# degrade; nothing else does.
setup_channel_transport() {
  local plan_entry plan unit_path unit_name unit_contents
  plan_entry="${CURRENT_DIR}/gateway/dist/openclaw/provisioning/openclaw-install-plan-cli.js"
  if [[ ! -f "${plan_entry}" ]]; then
    echo "empyralis-configure: this gateway build has no channel transport installer; channels stay unavailable" >&2
    return 1
  fi
  # As ${SERVICE_USER}: this writes the gateway's own state directory, and a
  # root-owned secrets file there is one the gateway cannot read — a transport
  # that is dead in a way that looks like nothing happened.
  if ! plan="$(sudo -u "${SERVICE_USER}" \
      env -i HOME="${INSTALL_ROOT}/cli/home" \
        PATH="${INSTALL_ROOT}/cli/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        NPM_CONFIG_PREFIX="${INSTALL_ROOT}/cli" \
        NPM_CONFIG_CACHE="${INSTALL_ROOT}/cli/npm-cache" \
        EMPYRALIS_GATEWAY_STATE_DIR="${STATE_ROOT}/gateway" \
        node "${plan_entry}" --ensure-runtime --provision --require-user "${SERVICE_USER}")"; then
    echo "empyralis-configure: could not set up messaging channels; the Agent Computer is unaffected" >&2
    return 1
  fi
  unit_path="$(printf '%s' "${plan}" | python3 -c 'import json,sys; p=json.load(sys.stdin)["unit"]; print(p["path"] if p else "")')"
  unit_name="$(printf '%s' "${plan}" | python3 -c 'import json,sys; p=json.load(sys.stdin)["unit"]; print(p["name"] if p else "")')"
  if [[ -z "${unit_path}" ]]; then
    echo "empyralis-configure: messaging channels installed but could not be set to start automatically" >&2
    return 1
  fi
  unit_contents="$(printf '%s' "${plan}" | python3 -c 'import json,sys; sys.stdout.write(json.load(sys.stdin)["unit"]["contents"])')"
  printf '%s' "${unit_contents}" > "${unit_path}"
  chmod 0644 "${unit_path}"
  systemctl daemon-reload
  systemctl enable "${unit_name}" >/dev/null 2>&1 || true
  systemctl restart "${unit_name}" || {
    echo "empyralis-configure: messaging channel support did not start (systemctl status ${unit_name})" >&2
    return 1
  }
  echo "empyralis-configure: messaging channels ready"
}

setup_channel_transport || echo "empyralis-configure: continuing without messaging channel support"

# The unit is already enabled on the image; daemon-reload is cheap insurance in
# case anything dropped a drop-in. `restart` rather than `start` so re-running
# this picks up a changed env file.
systemctl daemon-reload
systemctl enable "${GATEWAY_SERVICE}" >/dev/null
systemctl restart "${GATEWAY_SERVICE}"

echo "empyralis-configure: ${GATEWAY_SERVICE} started"
