[Unit]
Description=Empyralis Self-Hosted Command Worker
Documentation=https://empyralis.com/docs/self-hosted
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/empyralis

# ── Required environment ──────────────────────────────────────────────────
Environment="EMPYRALIS_CLOUD_URL=http://localhost:8001"
Environment="EMPYRALIS_RUNTIME_PROFILE_ID=CHANGE_ME"
Environment="EMPYRALIS_NODE_SESSION_TOKEN=CHANGE_ME"

# ── Optional tuning ───────────────────────────────────────────────────────
Environment="EMPYRALIS_POLL_INTERVAL=2.0"
Environment="EMPYRALIS_MAX_COMMANDS_PER_POLL=5"
Environment="EMPYRALIS_LEASE_SECONDS=120"
Environment="EMPYRALIS_WORKER_LOG_FORMAT=json"

# ── Python & kernel path ──────────────────────────────────────────────────
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="EMPYRALIS_RUNTIME_KERNEL_BIN=/root/empyralis/empyralis-runtime-kernel/target/release/empyralis-runtime-kernel"

# ── Exec ──────────────────────────────────────────────────────────────────
ExecStart=/usr/bin/python3 scripts/empyralis_self_hosted_command_worker.py
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# ── Security hardening ────────────────────────────────────────────────────
NoNewPrivileges=no
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
